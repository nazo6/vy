{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "moduleDetection": "force",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "paths": {
            "vy-api": ["./packages/vy-api/index.d.ts"]
        }
    },
    "include": [
        "examples/**/*.ts",
        "packages/vy-api/**/*.d.ts",
        "packages/vy-api-types/**/*.ts"
    ]
}
