# Editor defaults for everyone who opens this repository.
#
# Prettier and tombi own the exact layout of the file types they support.
# This file only covers the basics so that other editors and tools agree on
# line endings and indentation.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.py]
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
